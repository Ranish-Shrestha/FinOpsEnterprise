    <Extension>SQL</Extension>
    <ConnectString>Data Source=localhost,14333;Initial Catalog=FinOpsEnterprise;Encrypt=True;TrustServerCertificate=True</ConnectString>
  </ConnectionProperties>
  <DataSourceID>d432e9c2-8b6a-5ea1-acfa-ca3d4c4f6849</DataSourceID>
</RptDataSource>
